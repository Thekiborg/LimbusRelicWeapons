<?xml version="1.0" encoding="UTF-8"?>
<Defs>

    <ThingDef ParentName="LRW_RelicAbilityBase">
        <defName>LRW_LaevateinnSealed</defName>
        <label>Lævateinn (Sealed)</label>
        <description>A sword of overwhelming heat. \n\nOnce wielded by an Endwatcher of the ruins before being fragmented. This superheated blade acted as a source of a lava river before being found and sealed. The wielder is able to progressively undo the seals to unlock the blade's full potential at great risk to themself and everything around them.</description>
        <!--<graphicData>
            <drawSize>(1.4,1.4)</drawSize>
        </graphicData>-->
        <soundInteract>LRW_Sheathing</soundInteract>
        <meleeHitSound>MeleeHit_MonoSword</meleeHitSound>
        <equippedAngleOffset>-60</equippedAngleOffset>
        <tickerType>Long</tickerType>
        <graphicData>
            <texPath>LimbusWeapons/Weapons/LaevateinnSealed</texPath>
        </graphicData>
        <tools>
            <li>
                <label>sealed edge</label>
                <capacities>
                    <li>LRW_LaevateinnBlunt</li>
                </capacities>
                <power>10</power>
                <cooldownTime>2.2</cooldownTime>
            </li>
        </tools>
        <comps>
            <li Class="LimbusWeapons.CompProperties_Laevateinn">
                <progressPerAttack>0.1</progressPerAttack>
                <progressDecayPerDay>2</progressDecayPerDay>
            </li>
            <li Class="CompProperties_EquippableAbility">
                <abilityDef>LRW_UnsealFirstSeal</abilityDef>
            </li>
            <li Class="LimbusWeapons.CompProperties_Sheath">
                <renderNodeProperties>
                    <li Class="LimbusWeapons.PawnRenderNodeProperties_Sheath">
                        <debugLabel>Weapon Sheath</debugLabel>
                        <visibleFacing>
                            <li>East</li>
                            <li>South</li>
                            <li>West</li>
                            <li>North</li>
                        </visibleFacing>
                        <drawData>
                            <defaultData>
                                <layer>74</layer>
                                <rotationOffset>180</rotationOffset>
                            </defaultData>
                            <dataWest>
                                <layer>74</layer>
                                <rotationOffset>180</rotationOffset>
                                <flip>true</flip>
                            </dataWest>
                        </drawData>
                        <layerBehindBody>-6</layerBehindBody>
                        <texPathUndrafted>LimbusWeapons/Weapons/LaevateinnSealed</texPathUndrafted>
                    </li>
                </renderNodeProperties>
            </li>
        </comps>
    </ThingDef>


